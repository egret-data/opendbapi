            "type" : "string",
            "nullable" : true
          },
          "targetType" : {
            "type" : "string",
            "nullable" : true
          },
          "ts" : {
            "type" : "string",
            "format" : "date-time"
          },
          "username" : {
            "type" : "string",
            "nullable" : true
          },

{
  "realm": "opendbapi",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "opendbapi-admins" },
    { "name": "sales-authors" }
  ],
  "users": [
    {
      "username": "carol",
      "email": "carol@opendbapi.local",
      "firstName": "Carol",
      "lastName": "Le",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "groups": ["/opendbapi-admins"]
    },
    {
      "username": "dave",
      "email": "dave@opendbapi.local",
      "firstName": "Dave",
      "lastName": "Pham",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dave", "temporary": false }],
      "groups": ["/sales-authors"]
    }
  ],
  "clients": [
    {
      "clientId": "opendbapi",
      "name": "OpenDBAPI (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "opendbapi-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8520/*", "http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
